# =============================================================================
# Backend — copy to backend/.env
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app:app@localhost:5432/app
# Direct (non-PgBouncer) URL used by Alembic migrations. Leave empty unless you
# put PgBouncer in front of Postgres — then set both this and PGBOUNCER_MODE.
DATABASE_URL_DIRECT=
PGBOUNCER_MODE=false

# ── JWT — generate with: openssl rand -hex 32 ─────────────────────────────────
SECRET_KEY=your-secret-key-here
# Short access + rotating refresh: clients renew via POST /v1/auth/refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Encryption — Fernet key for app.utils.crypto (optional) ───────────────────
# Encrypts sensitive DB-stored values (e.g. third-party API keys).
# Falls back to SECRET_KEY when empty. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Redis — background jobs (ARQ) + cache ─────────────────────────────────────
# docker compose provides this automatically. Degrades gracefully when unset:
# no-op cache + in-process BackgroundTasks fallback.
REDIS_URL=redis://localhost:6379/0

# ── CORS — comma-separated list of allowed frontend origins ───────────────────
FRONTEND_URL=http://localhost:3000

# ── Internal API secret — generate with: openssl rand -hex 32 ────────────────
# Shared between Next.js server and FastAPI to protect /internal/* routes
INTERNAL_API_SECRET=your-internal-secret-here

# ── Email — Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=My App

# ── Trusted proxy IPs ─────────────────────────────────────────────────────────
# Use "*" on Railway (traffic passes through Railway's proxy)
TRUSTED_PROXY_IPS=127.0.0.1

# ── Security ──────────────────────────────────────────────────────────────────
# Never true in production deploys: DEBUG=true exposes full stack traces.
DEBUG=false
# Production: set CLOUDFLARE_ONLY=true to block requests that didn't pass through
# Cloudflare. REQUIRES CLOUDFLARE_SHARED_SECRET below — the app refuses to start
# without it, since the check is a no-op (blocks everything) otherwise.
#
# Setup (one-time, in the Cloudflare dashboard for this domain):
#   1. Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
#   2. Rules -> Transform Rules -> Modify Request Header -> Create rule
#      - When incoming requests match: hostname equals your Railway API hostname
#      - Then: Set static header "X-Origin-Auth" to the secret from step 1
#   3. Set CLOUDFLARE_SHARED_SECRET (below) to the same value in Railway.
#
# Zero-downtime activation order: (1) deploy frontend with CLOUDFLARE_SHARED_SECRET
# set, (2) create the Cloudflare Transform Rule, (3) only then CLOUDFLARE_ONLY=true.
#
# Why not just check the connecting IP against Cloudflare's ranges? On Railway
# (and similar platforms), Railway's own proxy sits between Cloudflare and the
# app — the raw TCP peer the app sees is always Railway's internal proxy, never
# Cloudflare's edge IP. That check blocks 100% of traffic unconditionally,
# including login. The shared-secret header is the fix.
CLOUDFLARE_ONLY=false
CLOUDFLARE_SHARED_SECRET=
# Comma-separated IPs allowed to hit /v1/admin/* routes (empty = allowlist off)
ADMIN_ALLOWED_IPS=

# ── Sentry — backend error tracking (optional) ────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Slack Bot — alert notifications (optional) ────────────────────────────────
# Create app at api.slack.com → OAuth & Permissions → Bot Token (xoxb-...)
# 500 alerts are auto-enriched with Railway/Vercel status (app.utils.infra_status).
SLACK_BOT_TOKEN=
# Channel where alerts land (e.g. #backend-alerts). The bot must be invited.
# Empty = alerts only reach the log. Lives here, not in code: this repo is
# public and a fork must not inherit anyone's channel.
SLACK_ALERT_CHANNEL=

# ── Google Safe Browsing — URL reputation checks (optional) ───────────────────
# Used by app.utils.url_security.check_safe_browsing. Fails open when empty.
GOOGLE_SAFE_BROWSING_API_KEY=

# ── OAuth — Google (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# OPTIONAL LAYERS — see docs/optional-layers.md for full setup
# =============================================================================

# ── Cloudinary — image / video uploads ───────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── AI / OpenAI-compatible provider ──────────────────────────────────────────
# Works with OpenAI, DeepSeek, Groq, Together AI, etc.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ── Langfuse — LLM observability ─────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Stripe — payments & subscriptions ────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_PRO=

# ── 2FA / TOTP — authenticator app codes ─────────────────────────────────────
# TOTP_ISSUER=My App

# ── GeoIP / MaxMind — country / city lookup ──────────────────────────────────
# Download GeoLite2-City.mmdb at maxmind.com (free account required)
# GEOIP_DB_PATH=/data/GeoLite2-City.mmdb

# ── ElevenLabs + Cloudflare R2 — AI voice generation ─────────────────────────
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://pub-xxx.r2.dev


# =============================================================================
# Frontend — copy to frontend/.env.local
# =============================================================================

NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# FastAPI URL (server-side Next.js calls)
API_URL=http://localhost:8000
# FastAPI URL (client-side browser calls)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal API secret (same value as backend)
INTERNAL_API_SECRET=your-internal-secret-here

# Cloudflare origin secret — SAME value as the backend's CLOUDFLARE_SHARED_SECRET.
# Next.js server-side calls go direct to Railway (not through Cloudflare), so a
# global fetch interceptor adds this header (X-Origin-Auth) to survive
# CLOUDFLARE_ONLY. Empty = nothing is added (harmless while CLOUDFLARE_ONLY=false).
# Zero-downtime activation order: (1) deploy frontend with this secret, (2) create
# the Cloudflare Transform Rule injecting the same header, (3) only then set
# CLOUDFLARE_ONLY=true on the backend.
CLOUDFLARE_SHARED_SECRET=

# ── OAuth — Google (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sentry — frontend error tracking (optional) ───────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
